# Create a project at https://supabase.com, then Project Settings -> API.
# Copy this file to .env.local and paste the two values there — .env.local is
# gitignored, this file is not.
#
# The anon key is a public client key: it is safe in a browser bundle because
# row-level security, not secrecy, is what protects the data. Never put the
# service_role key in either file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
